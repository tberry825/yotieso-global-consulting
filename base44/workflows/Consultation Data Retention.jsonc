{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "consultation_data_retention",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "archive_old": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveOldConsultations"
          },
          "then": "end",
          "x-base44": {
            "title": "Archive old consultations",
            "description": "Records older than 90 days"
          }
        }
      }
    ]
  },
  "name": "Consultation Data Retention",
  "description": "Archives consultation records older than 90 days to enforce the data retention policy stated in the Privacy Policy."
}