{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "service": {
      "type": "string",
      "title": "Service Interest"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "default": "Contact Page"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "booked",
        "archived"
      ]
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}